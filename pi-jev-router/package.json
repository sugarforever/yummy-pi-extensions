{
  "name": "@sugarforever/pi-jev-router",
  "version": "0.2.0",
  "description": "Per-turn session router for Pi: Jev decides whether a prompt should continue, fork, or start a new session before it pollutes the context",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugarforever/yummy-pi-extensions.git",
    "directory": "pi-jev-router"
  },
  "homepage": "https://github.com/sugarforever/yummy-pi-extensions/tree/main/pi-jev-router#readme",
  "bugs": "https://github.com/sugarforever/yummy-pi-extensions/issues",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jev",
    "typesafe",
    "session-router"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "ai": "^7.0.105"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.3.0",
    "tsdown": "^0.15.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
