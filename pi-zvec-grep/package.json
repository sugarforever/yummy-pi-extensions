{
  "name": "@sugarforever/pi-zvec-grep",
  "version": "0.2.0",
  "description": "Zero-command, continuously fresh zvec workspace search for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugarforever/yummy-pi-extensions.git",
    "directory": "pi-zvec-grep"
  },
  "homepage": "https://github.com/sugarforever/yummy-pi-extensions/tree/main/pi-zvec-grep#readme",
  "bugs": "https://github.com/sugarforever/yummy-pi-extensions/issues",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "zvec",
    "semantic-search"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@zvec/zvec-grep": "^0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.3.0",
    "tsdown": "^0.15.1",
    "typescript": "^5.9.2",
    "typebox": "^1.3.27",
    "vitest": "^3.2.4"
  }
}
